// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////
//      Retail Inventory
////////////////////////////////////////

model retail {
  sku Int @id
  name String
  description String
  price Float
  productType String
  image String
  isOnSale Boolean @default(false)
  isInCart Boolean @default(false)
  isWishListed Boolean @default(false)
}
////////////////////////////////////////
//      Rental Inventory
////////////////////////////////////////

model rental {
    sku Int @id
    name String
    description String
    productType String
    image String
    isRented Boolean @default(false)
    isSelected Boolean @default(false)
}


////////////////////////////////////////
//      Notfication
////////////////////////////////////////

model Notfication {
  email String @id
  dateAdded DateTime @default(now())
}


////////////////////////////////////////
//      WishList
////////////////////////////////////////

model wishList {
  email String @id
  items String[]
  dateAdded DateTime @default(now())
}

////////////////////////////////////////
//      Credit Card Info
////////////////////////////////////////

model Form {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  card      String
  expiry    String
  cve       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}